{
  "schemaVersion": 1,
  "id": "linkedin-profile-api",
  "version": "0.2.0",
  "product": "leadadapter",
  "credential": "LEADADAPTER_API_KEY",
  "executionAuthority": "https://leadadapter.com/api/v1",
  "verification": {
    "package": "Tested",
    "providerExecution": "Documented",
    "method": "synthetic-contract-fixtures"
  },
  "discovery": {
    "operationMetadata": "lib/operations.js",
    "selectedOperationIds": [
      "enrich_post"
    ]
  },
  "tasks": [
    {
      "name": "linkedin-profile-enrichment",
      "description": "Enrich selected LinkedIn profiles through LeadAdapter. Use when an existing shortlist needs source-backed profile details.",
      "instructions": ".agents/skills/linkedin-profile-enrichment/SKILL.md"
    }
  ],
  "workflow": {
    "name": "research-to-crm",
    "defaultMode": "plan",
    "nativeCrmDefault": true,
    "explicitMutationApproval": true,
    "checkpointRequiredForLive": true
  },
  "install": {
    "codex": "agents install --client codex --scope project",
    "claude": "agents install --client claude --scope project",
    "grok": "agents install --client grok --scope project"
  }
}
